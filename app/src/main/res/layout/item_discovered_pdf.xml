<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_discovered_pdf"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- File Type Icon Indicator -->
        <FrameLayout
            android:id="@+id/fl_discovered_icon_bg"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:backgroundTint="#FFFEE2E2"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/iv_discovered_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#FFE11D48" />
        </FrameLayout>

        <!-- PDF Text Information -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_discovered_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quarterly_Report_2026.pdf"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_discovered_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.2 MB"
                    android:textSize="11sp"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textSize="11sp"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/tv_discovered_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jul 9, 2026"
                    android:textSize="11sp"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_discovered_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="/storage/emulated/0/Download"
                android:textSize="10sp"
                android:textColor="@color/on_surface_variant"
                android:maxLines="1"
                android:ellipsize="start" />
        </LinearLayout>

        <!-- Action Items (Share) -->
        <ImageButton
            android:id="@+id/btn_discovered_share"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_share"
            android:contentDescription="Share file"
            app:tint="@color/on_surface_variant"
            android:layout_marginStart="8dp" />

        <!-- Action Items (Delete) -->
        <ImageButton
            android:id="@+id/btn_discovered_delete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="Delete file"
            app:tint="@color/error"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
