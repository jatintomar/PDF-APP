<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Image Toolbox"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="On-device filters, transforms, watermarks, format conversions &amp; stitching."
                android:textSize="13sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginBottom="16dp" />

            <!-- Image Selection & Live Preview Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_image_preview_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <!-- Empty State Select Button -->
                    <LinearLayout
                        android:id="@+id/layout_empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#0A000000">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@android:drawable/ic_menu_gallery"
                            app:tint="@color/primary"
                            android:layout_marginBottom="8dp" />

                        <Button
                            android:id="@+id/btn_pick_images"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select Image(s)"
                            app:icon="@android:drawable/ic_menu_add" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select 1 image to edit, or multiple to stitch/batch"
                            android:textSize="11sp"
                            android:textColor="@color/on_surface_variant"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <!-- Active Image Preview -->
                    <LinearLayout
                        android:id="@+id/layout_preview_active"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/iv_preview"
                            android:layout_width="match_parent"
                            android:layout_height="240dp"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            android:background="#10000000" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="10dp">

                            <TextView
                                android:id="@+id/tv_image_info"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="1080 x 1920 px"
                                android:textSize="12sp"
                                android:textColor="@color/on_surface_variant" />

                            <Button
                                android:id="@+id/btn_change_images"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="Change"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Multi-Image Stitch Option Card (Visible when multiple images are picked) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_stitch_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stitch / Stack Images"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface"
                        android:layout_marginBottom="8dp" />

                    <RadioGroup
                        android:id="@+id/rg_stitch_direction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rb_stitch_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Vertical Strip"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rb_stitch_horizontal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Horizontal Grid" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Transforms (Rotate & Flip) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Transforms"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/on_surface"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btn_rotate_cw"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Rotate 90°"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_marginEnd="4dp"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_flip_h"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Flip Horiz"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_marginEnd="4dp"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_flip_v"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Flip Vert"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Filter Presets Horizontal Scroll -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filter Presets"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/on_surface"
                android:layout_marginBottom="8dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_filters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_original"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Original"
                        android:checked="true"
                        style="@style/Widget.MaterialComponents.Chip.Choice" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_grayscale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grayscale"
                        style="@style/Widget.MaterialComponents.Chip.Choice" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_sepia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sepia"
                        style="@style/Widget.MaterialComponents.Chip.Choice" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_vintage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vintage"
                        style="@style/Widget.MaterialComponents.Chip.Choice" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_warm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Warm"
                        style="@style/Widget.MaterialComponents.Chip.Choice" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_cool"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cool"
                        style="@style/Widget.MaterialComponents.Chip.Choice" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_high_contrast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="High Contrast"
                        style="@style/Widget.MaterialComponents.Chip.Choice" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_invert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Invert"
                        style="@style/Widget.MaterialComponents.Chip.Choice" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_vignette"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vignette"
                        style="@style/Widget.MaterialComponents.Chip.Choice" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_bw"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="B&amp;W Doc"
                        style="@style/Widget.MaterialComponents.Chip.Choice" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Adjustments Sliders (Brightness, Contrast, Saturation) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Color &amp; Tone Tuning"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/on_surface"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_brightness_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brightness: 0"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_brightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="-50.0"
                android:valueTo="50.0"
                android:value="0.0"
                android:stepSize="1.0" />

            <TextView
                android:id="@+id/tv_contrast_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contrast: 1.0x"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_contrast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0.5"
                android:valueTo="2.0"
                android:value="1.0"
                android:stepSize="0.05" />

            <!-- Watermark Input & Format settings -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_watermark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Watermark Stamp (Optional)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_watermark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Output Format & Quality -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Export Format &amp; Quality"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/on_surface"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rg_format"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/rb_format_jpg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="JPEG"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rb_format_webp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WEBP" />

                <RadioButton
                    android:id="@+id/rb_format_png"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PNG" />
            </RadioGroup>

            <TextView
                android:id="@+id/tv_quality_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Compression Quality: 85%"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="10.0"
                android:valueTo="100.0"
                android:value="85.0"
                android:stepSize="5.0"
                android:layout_marginBottom="20dp" />

            <!-- Save Action Button -->
            <Button
                android:id="@+id/btn_save_processed"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Process &amp; Save Image"
                android:textSize="16sp"
                android:enabled="false"
                android:layout_marginBottom="16dp" />

            <!-- Progress Indicator -->
            <LinearLayout
                android:id="@+id/progress_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Processing image on-device..."
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
