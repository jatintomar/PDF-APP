<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_folder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Folder Icon Indicator -->
        <FrameLayout
            android:id="@+id/fl_folder_icon_bg"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:backgroundTint="#FFE0F2FE"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/iv_folder_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_folder"
                app:tint="#FF0284C7" />
        </FrameLayout>

        <!-- Folder Text Information -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_folder_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Download"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_folder_file_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="15 documents"
                android:textSize="11sp"
                android:textColor="@color/on_surface_variant" />

            <TextView
                android:id="@+id/tv_folder_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="/storage/emulated/0/Download"
                android:textSize="10sp"
                android:textColor="@color/on_surface_variant"
                android:maxLines="1"
                android:ellipsize="start" />
        </LinearLayout>

        <!-- Chevron indicator -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_media_play"
            app:tint="@color/on_surface_variant"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
