<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/surface">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fidelity Slider Comparison"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Drag your finger across the image to inspect compression quality."
        android:textSize="12sp"
        android:textColor="@color/on_surface_variant"
        android:layout_marginBottom="16dp" />

    <!-- Split Pane Frame -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="280dp"
        app:cardCornerRadius="12dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/outline"
        android:layout_marginBottom="16dp">

        <com.pdfutility.tools.SplitComparisonView
            android:id="@+id/split_comparison_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF0F172A" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Quick Slider to preview with different values -->
    <TextView
        android:id="@+id/tv_dialog_quality_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Live Compression Quality: 80%"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_dialog_quality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="5"
        android:valueTo="100"
        android:value="80"
        app:labelBehavior="gone"
        android:layout_marginBottom="16dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_dialog_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Close"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_dialog_apply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply &amp; Select Quality" />
    </LinearLayout>
</LinearLayout>
